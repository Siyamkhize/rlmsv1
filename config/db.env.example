# Database Configuration Template
# Copy this file to db.env and fill in your actual credentials
# NEVER commit db.env to git!

DB_HOST=localhost
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_password
DB_NAME=your_database_name
DB_TABLE=sdp
DB_CHARSET=utf8mb4
DB_TIMEZONE=+02:00

# Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true
