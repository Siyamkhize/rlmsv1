# Production Environment Configuration
ENVIRONMENT=production
API_BASE_URL=https://api.rlms.example.com
APP_NAME=RLMS
DEBUG_MODE=false
LOG_LEVEL=error

# Database
DB_HOST=production-db.example.com
DB_NAME=rlms_production

# Firebase (use production Firebase project)
FIREBASE_PROJECT_ID=rlms-production
FIREBASE_API_KEY=your-production-api-key

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_TOOLS=false

# Analytics
ANALYTICS_ENABLED=true
SENTRY_DSN=your-production-sentry-dsn

# Security
SSL_PINNING_ENABLED=true
CERTIFICATE_VALIDATION=strict
OBFUSCATE_CODE=true
