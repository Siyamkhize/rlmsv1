# Staging Environment Configuration
ENVIRONMENT=staging
API_BASE_URL=https://api-staging.rlms.example.com
APP_NAME=RLMS Staging
DEBUG_MODE=true
LOG_LEVEL=debug

# Database
DB_HOST=staging-db.example.com
DB_NAME=rlms_staging

# Firebase (use staging Firebase project)
FIREBASE_PROJECT_ID=rlms-staging
FIREBASE_API_KEY=your-staging-api-key

# Feature Flags
ENABLE_BETA_FEATURES=true
ENABLE_DEBUG_TOOLS=true

# Analytics
ANALYTICS_ENABLED=true
SENTRY_DSN=your-staging-sentry-dsn

# Security
SSL_PINNING_ENABLED=false
CERTIFICATE_VALIDATION=relaxed
