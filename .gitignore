# Environment variables - CRITICAL SECURITY
# Block all .env files except examples
.env
.env.*
!.env.example
*.env
!*.env.example
config/db.env
!config/db.env.example
!config/db.env.staging

# Database credentials - DO NOT commit connection.php with real credentials
# (These files are now safe - they read from .env files)

# Debug and test files
debug_*.php
test_*.php
check_*.php
fix_*.php
diagnose_*.php

# Logs
*.log
error.log
debug.log

# Temporary files
*.tmp
*.temp
/temp/
/tmp/

# Uploads (should be outside web root)
/uploads/
/mobile/uploads/

# Vendor
/vendor/

# Python virtual environment
venv/
/venv/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.apk
*.aab
build/
.dart_tool/

# Local config files (not used)
lib/config_local.dart
lib/config_localhost.dart
config_local.dart
config_localhost.dart

# Sensitive documentation (audit reports with potential credentials)
*_AUDIT_CREDENTIALS*.md
*_PASSWORD*.md

# Git backup
.git_backup_corrupted/

# APK files - don't upload
*.apk
*.aab
build/
android/app/build/
