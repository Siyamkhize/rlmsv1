# Block ALL PHP execution - Signatures directory
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# Only allow PNG images (signatures)
<FilesMatch "(?i)\.png$">
    Require all granted
</FilesMatch>

Require all denied
